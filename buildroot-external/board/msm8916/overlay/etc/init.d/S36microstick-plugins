#!/bin/sh
case "$1" in
 start) /usr/libexec/microstick-data check || exit 0
        start-stop-daemon -S -b -m -p /run/microstick/plugins.pid -x /usr/libexec/microstick-plugins ;;
 stop) for s in /run/microstick/plugins/*; do [ ! -d "$s" ] || /usr/libexec/microstick-plugins stop "${s##*/}" || :; done
       start-stop-daemon -K -p /run/microstick/plugins.pid ;;
esac
