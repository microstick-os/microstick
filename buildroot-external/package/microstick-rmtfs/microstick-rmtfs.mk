MICROSTICK_RMTFS_VERSION = 293ab8babb27ac0f24247bb101fed9420c629c29
MICROSTICK_RMTFS_SOURCE = rmtfs-$(MICROSTICK_RMTFS_VERSION).tar.gz
MICROSTICK_RMTFS_SITE = $(call github,linux-msm,rmtfs,$(MICROSTICK_RMTFS_VERSION))
MICROSTICK_RMTFS_LICENSE = BSD-3-Clause
MICROSTICK_RMTFS_LICENSE_FILES = LICENSE
MICROSTICK_RMTFS_DEPENDENCIES = microstick-qrtr udev

define MICROSTICK_RMTFS_BUILD_CMDS
	$(TARGET_MAKE_ENV) $(MAKE) -C $(@D) CC="$(TARGET_CC)" CFLAGS="$(TARGET_CFLAGS)" LDFLAGS="$(TARGET_LDFLAGS) -lqrtr -ludev -lpthread" rmtfs
endef
define MICROSTICK_RMTFS_INSTALL_TARGET_CMDS
	$(INSTALL) -D -m 0755 $(@D)/rmtfs $(TARGET_DIR)/usr/bin/rmtfs
endef
$(eval $(generic-package))
